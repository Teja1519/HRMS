          }
        },
        {
          "name": "Get All Attendance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/attendance"
          }
        },
        {
          "name": "Get Attendance by Employee",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/attendance/1"
          }
        }
      ]
    },
